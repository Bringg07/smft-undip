# === Database (Neon / PostgreSQL serverless) ===
# Salin connection string dari dashboard Neon → Connection Details → Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# === Auth (NextAuth v5) ===
# Generate secret: npx auth secret  (atau string acak panjang)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# === Akun admin awal (dibuat oleh prisma/seed.ts) ===
ADMIN_EMAIL="admin@smftundip.com"
ADMIN_PASSWORD="ganti-password-admin"
