# ============================================
# SMFT UNDIP — Template .env
# Salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
# ============================================

# --- PostgreSQL ---
# Neon:   Connection Details → Prisma
# Supabase: Project Settings → Database → URI Transaction (port 6543),
#           tambahkan ?pgbouncer=true&connection_limit=1
DATABASE_URL=""

# Koneksi langsung untuk migrasi (port 5432). Wajib untuk Supabase, opsional untuk Neon.
DIRECT_URL=""

# --- Keamanan sesi (NextAuth) ---
# Generate: npx auth secret
AUTH_SECRET=""

# --- Kredensial admin awal (dipakai oleh `npm run db:seed`) ---
ADMIN_EMAIL="admin@smftundip.com"
ADMIN_PASSWORD=""
