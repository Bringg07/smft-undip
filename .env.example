# === Database (PostgreSQL — Neon / Supabase / lainnya) ===
# DATABASE_URL: koneksi utama aplikasi.
#  - Neon: Connection Details → Prisma
#  - Supabase: Project Settings → Database → Connection string → Transaction (port 6543)
#    + tambahkan ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# DIRECT_URL (khusus Supabase): koneksi langsung untuk migrasi Prisma.
# Supabase: Project Settings → Database → Connection string → Direct (port 5432)
# Untuk provider lain boleh dikosongkan (Prisma akan memakai DATABASE_URL).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# === Auth (NextAuth v5) ===
# Generate secret: npx auth secret  (atau string acak panjang)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# === Akun admin awal (dibuat oleh prisma/seed.ts) ===
ADMIN_EMAIL="admin@smftundip.com"
ADMIN_PASSWORD="ganti-password-admin"
