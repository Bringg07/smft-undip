// Prisma schema — SMFT UNDIP
// Database: PostgreSQL (mis. Neon serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Koneksi langsung (port 5432) — dipakai Prisma untuk menjalankan migrasi.
  // Opsional untuk provider lain (Neon dsb.); jika kosong, Prisma memakai DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// Akun admin untuk dashboard (/admin)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// Artikel berita publik
model Berita {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String
  content   String[] // daftar paragraf isi berita
  category  String
  author    String
  date      String // tanggal tampil, mis. "25 Juli 2026"
  image     String? // foto sampul (data URL) — opsional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Aspirasi mahasiswa (dikirim dari form publik)
model Aspirasi {
  id        Int            @id @default(autoincrement())
  nama      String
  nim       String
  tujuan    String
  pesan     String
  status    AspirasiStatus @default(Baru)
  createdAt DateTime       @default(now())
}

enum AspirasiStatus {
  Baru
  Ditindaklanjuti
}

// Pengurus (untuk kartu pimpinan di beranda)
model Pengurus {
  id       Int     @id @default(autoincrement())
  nama     String
  jabatan  String
  kategori String // Pimpinan | Sekretariat | Bendahara | Badan | Komisi
  urutan   Int     @default(0)
  foto     String? // data URL foto — opsional
}

// Galeri foto kegiatan
model Galeri {
  id        Int      @id @default(autoincrement())
  judul     String
  gambar    String // data URL
  createdAt DateTime @default(now())
}

// Dokumen resmi (PDF dsb., disimpan sebagai data URL)
model Dokumen {
  id        Int      @id @default(autoincrement())
  judul     String
  kategori  String
  deskripsi String?
  filename  String?
  file      String // data URL file
  createdAt DateTime @default(now())
}

// Program kerja
model ProgramKerja {
  id        Int      @id @default(autoincrement())
  title     String
  category  String // Komisi 1, Badan Advokasi, dst.
  status    Status   @default(Berjalan)
  desc      String
  periode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Status {
  Selesai
  Berjalan
  Segera
}
